# Скопируйте в .env: cp .env.example .env
# Значения ниже совпадают с дефолтами docker-compose и годятся для локального запуска.

# --- API ---
API_KEY=local-dev-api-key
LOG_LEVEL=INFO
LOG_JSON=true

# --- PostgreSQL ---
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=payments
RABBITMQ_URL=amqp://payments:payments@rabbitmq:5672/

# --- Эмуляция платёжного шлюза ---
# Задержка ответа шлюза и доля успешных платежей (0.9 = 90% succeeded, 10% failed).
GATEWAY_MIN_DELAY_SECONDS=2.0
GATEWAY_MAX_DELAY_SECONDS=5.0
GATEWAY_SUCCESS_RATE=0.9

# --- Webhook ---
WEBHOOK_TIMEOUT_SECONDS=5.0
# Секрет для HMAC-SHA256 подписи в заголовке X-Webhook-Signature
WEBHOOK_SIGNING_SECRET=local-dev-webhook-secret

# --- Retry / DLQ ---
# 3 попытки с экспоненциальной задержкой: 1с, 5с, 25с
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MULTIPLIER=5.0

# --- Outbox relay ---
OUTBOX_POLL_INTERVAL_SECONDS=0.2
OUTBOX_BATCH_SIZE=50
